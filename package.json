{
  "name": "pda-plataforma-apoyo-agricola",
  "version": "1.0.0",
  "description": "PDA (Plataforma de Apoyo Agricola): recomendaciones de cultivo y estimaciones de produccion para agricultores.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "db:init": "node scripts/init-db.js",
    "db:seed": "node scripts/seed-db.js",
    "db:reset": "node scripts/reset-db.js",
    "simulator": "node simulator/index.js",
    "simulator:normal": "node simulator/index.js --scenario=normal",
    "simulator:dry": "node simulator/index.js --scenario=soil-dry",
    "simulator:heat": "node simulator/index.js --scenario=heat",
    "simulator:low-water": "node simulator/index.js --scenario=low-water",
    "simulator:disconnect": "node simulator/index.js --scenario=disconnect"
  },
  "keywords": [
    "agricultura",
    "cultivos",
    "open-meteo",
    "express",
    "hackathon"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "pdfkit": "^0.15.2",
    "sqlite3": "^6.0.1"
  }
}