PORT=3000

# Open-Meteo no requiere API key para el endpoint usado por esta app.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_FALLBACK_ENABLED=true

# Configuracion opcional para Perenual.
# Por defecto PDA usa el catalogo local para que la busqueda no dependa de rate limits externos.
# Activa PERENUAL_CROPS_ENABLED=true solo si quieres enriquecer esos cultivos con Perenual.
PERENUAL_API_URL=https://perenual.com/api/v2
PERENUAL_API_KEY=
PERENUAL_CROPS_ENABLED=false
PERENUAL_MAX_RETRIES=1

# Configuracion opcional para Nominatim (geocodificacion inversa).
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_USER_AGENT=PDA/1.0 (https://github.com/byvidal/CODE-TEC)
