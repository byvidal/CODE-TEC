PORT=3000

# Open-Meteo no requiere API key para el endpoint usado por esta app.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Configuracion opcional para FgFarm u otra API compatible de cultivos.
# Si no se define, PDA usa un catalogo local de respaldo.
FGFARM_API_URL=
FGFARM_API_KEY=
